{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "default_locale": "en",
  "version": "1.6.1",
  "description": "__MSG_ext_desc__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*",
        "https://www.twitch.tv/*",
        "https://kick.com/*",
        "https://lichess.org/*",
        "https://github.com/*",
        "https://bitcointalk.org/*",
        "https://medium.com/*",
        "https://*.medium.com/*",
        "https://www.youtube.com/*",
        "https://rumble.com/*",
        "https://anilist.co/*",
        "https://myanimelist.net/*",
        "https://www.smogon.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html"
      ],
      "matches": [
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*",
        "https://www.twitch.tv/*",
        "https://kick.com/*",
        "https://lichess.org/*",
        "https://github.com/*",
        "https://bitcointalk.org/*",
        "https://medium.com/*",
        "https://*.medium.com/*",
        "https://www.youtube.com/*",
        "https://rumble.com/*",
        "https://anilist.co/*",
        "https://myanimelist.net/*",
        "https://www.smogon.com/*"
      ]
    }
  ]
}
